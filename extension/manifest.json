{
  "manifest_version": 3,
  "name": "抖音直播弹幕助手（主播版）",
  "version": "1.16.138",
  "description": "读取你自己抖音直播间的评论与弹幕，按规则自动回复（主播模式，本地运行，可选 AI）。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://live.douyin.com/*",
    "https://api.deepseek.com/*",
    "https://api.minimax.cn/*",
    "https://api.minimax.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "抖音直播弹幕助手"
  },
  "side_panel": {
    "default_path": "app/app.html"
  },
  "content_scripts": [
    {
      "matches": ["https://live.douyin.com/*"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://live.douyin.com/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://live.douyin.com/*"],
      "js": ["content/live-keepalive.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}


